<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SaoSave.Web</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="8.0.30" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="8.0.30" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SaoSave.Core\SaoSave.Core.csproj" />
    <!-- The plain-English names and notes of the Advanced page are shared with the desktop editor. -->
    <Compile Include="..\SaoSave.Editor\AdvancedHelp.cs" Link="AdvancedHelp.cs" />
  </ItemGroup>

</Project>
