@if (S.Tree == null)
{
    <p class="warning">This save could not be read as the game's full layout, so this page is off. The other pages still work.@(S.TreeError == null ? "" : "\n" + S.TreeError)</p>
}
else if (_slots.Count == 0)
{
    <p class="warning">No save slots were found.</p>
}
else
{
    <div class="form">
        <div class="toolbar">
            <select @onchange="e => { S.LooksWho = int.Parse(e.Value!.ToString()!); S.Rebuild(); }">
                @for (int i = 0; i < _slots.Count * 2; i++)
                {
                    var s = _slots[i / 2];
                    string w = i % 2 == 0 ? "Player" : "ArFA-sys";
                    <option value="@i" selected="@(i == Who)">@s.Name @w  (@S.Val(s.Find(w + "/name/source")))</option>
                }
            </select>
        </div>
        <p class="note">
            Costumes, accessories and weapons list what is in this slot's bag. Pick one marked "not in bag" and it is added to the bag and equipped.
            Costume names end in F (female) or M (male): pick one that matches the gender.
            Edits are checked against the game's layout before they are accepted. Save, then test one change in game before changing many.
        </p>

        <div class="columns">
            <div>
                <h2>Looks</h2>
                <div class="row"><label>Name</label>
                    <input type="text" maxlength="16" value="@S.Val(Ch.Find("name/source"))" @onchange="e => SetName(e.Value?.ToString() ?? string.Empty)" />
                </div>
                <div class="row"><label>Gender</label>
                    <select @onchange="e => SetGender(e.Value?.ToString() ?? string.Empty)">
                        <option value="0" selected="@(S.Val(Ch.Find("gender")) != "1")">Male (0)</option>
                        <option value="1" selected="@(S.Val(Ch.Find("gender")) == "1")">Female (1)</option>
                    </select>
                </div>
                <div class="row"><label>Face paint</label>
                    <select @onchange="e => SetPaint(e.Value?.ToString() ?? string.Empty)">
                        @foreach (var p in PaintChoices)
                        {
                            <option value="@p" selected="@(p == CurrentPaint)">@p</option>
                        }
                    </select>
                </div>
                @foreach (var (label, part, max) in LookParts)
                {
                    var (l, pt, mx) = (label, part, max);
                    var node = Look?.Find($"parts/{pt}/id");
                    <div class="row"><label>@l</label>
                        <Num Value="int.TryParse(S.Val(node), out var cur) ? cur : 0" Max="mx" OnSet="v => SetPart(node, l, (int)v)" />
                        <span class="muted">1 to @mx</span>
                    </div>
                }
                <p class="note">
                    The game stores the hair, face and eyebrow choice as three numbers. Which number is which is read from a real save
                    (hair up to 70, face and eyebrows up to 50). Colours are not edited here: set those in the game's own customizer.
                </p>
            </div>

            <div>
                <h2>Costume and gear</h2>
                @if (Inv == null || Eq == null)
                {
                    <p class="warning">This slot has no equipment list.</p>
                }
                else
                {
                    @for (int k = 0; k < 5; k++)
                    {
                        int kk = k;
                        <div class="row"><label>@GearNames[kk]</label>
                            <Picker Items="GearOptions(kk)" Current="@GearCurrent(kk)" OnPick="key => PickGear(kk, key)" />
                        </div>
                    }
                    <p class="note">
                        @_owned[2].Count costumes, @_owned[3].Count accessories and @_owned[0].Count weapons are in this slot's bag.
                        Companions such as Kureha keep their own sets and are not listed here.
                    </p>
                }
            </div>
        </div>
    </div>
}

@code {
    [CascadingParameter] public EditorState S { get; set; } = default!;

    private static readonly string[] GearNames = { "Weapon 1", "Weapon 2", "Costume", "Accessory 1", "Accessory 2" };

    // The game's own customize lists: 70 hairstyles, 50 faces, 50 eyebrows.
    private static readonly (string label, string part, int max)[] LookParts =
    {
        ("Hairstyle", "[0]", 70), ("Face", "[1]", 50), ("Eyebrows", "[2]", 50),
    };

    private static readonly string[] FacePaints =
        ("None FACEPAINT_001 FACEPAINT_002 FACEPAINT_003 FACEPAINT_004 FACEPAINT_005 FACEPAINT_006 FACEPAINT_007 " +
         "FACEPAINT_009 FACEPAINT_010 FACEPAINT_011 FACEPAINT_012 FACEPAINT_013 FACEPAINT_014 FACEPAINT_015 FACEPAINT_016 " +
         "FACEPAINT_017 FACEPAINT_018 FACEPAINT_019 FACEPAINT_020 FACEPAINT_021 FACEPAINT_022 FACEPAINT_023 FACEPAINT_024 " +
         "FACEPAINT_025 FACEPAINT_026 FACEPAINT_027 FACEPAINT_028 FACEPAINT_029 FACEPAINT_030 FACEPAINT_031 FACEPAINT_032").Split(' ');

    private const string NotOwned = "new:";

    private List<SaoNode> _slots = new();
    private readonly Dictionary<int, List<Picker.Item>> _owned = new() { [0] = new(), [2] = new(), [3] = new() };
    private readonly Dictionary<int, List<SaoItem>> _notOwned = new();

    private int Who => Math.Clamp(S.LooksWho, 0, Math.Max(0, _slots.Count * 2 - 1));
    private SaoNode Slot => _slots[Who / 2];
    private string WhoName => Who % 2 == 0 ? "Player" : "ArFA-sys";
    private SaoNode Ch => Slot.Find(WhoName)!;
    private SaoNode? Look => Ch.Find("look");
    private SaoNode? Inv => Slot.Find("Inventory");
    private SaoNode? Eq => Slot.Find("Equipment")?.Children.ElementAtOrDefault(Who % 2 == 0 ? 1 : 2);

    private string CurrentPaint => S.Val(Look?.Find("face paint")) is { Length: > 0 } p ? p : "None";
    private IEnumerable<string> PaintChoices => FacePaints.Contains(CurrentPaint) ? FacePaints : FacePaints.Append(CurrentPaint);

    protected override void OnInitialized()
    {
        if (S.Tree == null) return;
        _slots = Enumerable.Range(1, 16).Select(i => S.Tree.Find($"Slot {i}")).TakeWhile(s => s != null).Select(s => s!).ToList();
        if (_slots.Count == 0 || Inv == null) return;

        var ownedIds = new HashSet<string>(StringComparer.Ordinal);
        foreach (var it in Inv.Children)
        {
            string id = it.Find("item id")?.Text ?? ItemRecord.EmptyId;
            if (id == ItemRecord.EmptyId) continue;
            ownedIds.Add(id);
            if (!int.TryParse(S.Val(it.Find("category")), out int cat) || !_owned.TryGetValue(cat, out var list)) continue;
            if (!int.TryParse(S.Val(it.Find("entry id")), out int entry) || entry < 0) continue;
            list.Add(new Picker.Item(entry.ToString(), SaoItems.NameOf(id)));
        }
        foreach (var l in _owned.Values) l.Sort((a, b) => string.Compare(a.Name, b.Name, StringComparison.OrdinalIgnoreCase));

        foreach (var kind in new[] { 0, 2, 3 })
        {
            var cat = kind == 0 ? ItemCategory.Weapon : kind == 2 ? ItemCategory.Costume : ItemCategory.Accessory;
            _notOwned[kind] = SaoItems.All.Where(i => SaoItems.CategoryOf(i.Id) == cat && !ownedIds.Contains(i.Id))
                .OrderBy(i => i.Name, StringComparer.OrdinalIgnoreCase).ToList();
        }
    }

    private static int KindOf(int k) => k < 2 ? 0 : k == 2 ? 2 : 3;

    private string GearCurrent(int k) => int.TryParse(S.Val(Eq!.Find($"slot {k}")), out int v) ? v.ToString() : "-1";

    private List<Picker.Item> GearOptions(int k)
    {
        int kind = KindOf(k);
        var options = new List<Picker.Item>();
        if (kind != 2) options.Add(new Picker.Item("-1", "(nothing)"));
        options.AddRange(_owned[kind]);
        options.AddRange(_notOwned[kind].Select(i => new Picker.Item(NotOwned + i.Id, i.Name, "not in bag: will be added" + (i.Dlc ? " · DLC" : ""))));
        string cur = GearCurrent(k);
        if (!options.Any(o => o.Key == cur)) options.Add(new Picker.Item(cur, "(unknown item)"));
        return options;
    }

    private void SetPart(SaoNode? node, string label, int v) => S.Apply(node, v.ToString(), $"{Slot.Name} {WhoName}: {label.ToLowerInvariant()} = {v}");

    private void SetGender(string v) => S.Apply(Ch.Find("gender"), v, $"{Slot.Name} {WhoName}: gender = {(v == "1" ? "female" : "male")}");
    private void SetPaint(string v) => S.Apply(Look?.Find("face paint"), v, $"{Slot.Name} {WhoName}: face paint = {v}");

    private void SetName(string text)
    {
        string t = text.Trim();
        if (t.Length == 0) { S.Rebuild(); return; }
        S.Apply(Ch.Find("name/source"), t, $"{Slot.Name} {WhoName}: name = {t}");
    }

    private void PickGear(int k, string key)
    {
        if (key.StartsWith(NotOwned)) { AddAndEquip(key[NotOwned.Length..], k); return; }
        S.Apply(Eq!.Find($"slot {k}"), key, $"{Slot.Name} {WhoName}: {GearNames[k]} = {GearOptions(k).FirstOrDefault(o => o.Key == key)?.Name}");
    }

    /// <summary>Adds the item to this slot's bag and equips it. A full bag swaps the worn costume or accessory instead.</summary>
    private void AddAndEquip(string itemId, int k)
    {
        try
        {
            var save = S.Save!;
            var inv = Inv!;
            var eq = Eq!;
            int equipIndex = Who % 2 == 0 ? 1 : 2;
            var c = save.Committed();
            var bag = c.Arrays.Where(a => a.Slots.Count == 500).FirstOrDefault(b => b.CountOffset == inv.Offset);
            if (bag == null || !inv.Children.Select(n => n.Find("item id")?.Text ?? ItemRecord.EmptyId).SequenceEqual(bag.Slots.Select(s => s.Id)))
                throw new ArgumentException("This slot has no bag the editor can add to (only a slot that has been played). Use a slot with progress.");
            int free = bag.Slots.FindIndex(s => s.IsEmpty);
            if (free < 0 && k >= 2 && int.TryParse(S.Val(eq.Find($"slot {k}")), out int worn) && worn >= 0
                && inv.Children.ElementAtOrDefault(worn)?.Find("item id") is { } idNode)
            {
                string old = SaoItems.NameOf(idNode.Text ?? "");
                var swapped = SaoTreeEdit.Set(save, idNode, itemId) ?? save;
                S.Replace(swapped, $"{Slot.Name} {WhoName}: bag full, so {old} became {SaoItems.NameOf(itemId)} ({GearNames[k]}).");
                return;
            }
            if (free < 0) throw new ArgumentException($"The bag is full ({bag.Used} of {bag.Slots.Count}). Remove some items on the Inventory page first, then pick this again.");
            if (!SaoEdits.AddItem(c, bag, itemId)) throw new ArgumentException("Could not add the item: there is no item of that kind in the save to copy.");
            var next = c.Committed();
            var t2 = next.ParseTree();
            if (SaoTreeEdit.Format(next, t2.Find($"{Slot.Name}/Inventory/[{free}]/entry id")!) != free.ToString())
                throw new ArgumentException("The new item got an unexpected bag position, so nothing was changed.");
            SaoTreeEdit.Set(next, t2.Find($"{Slot.Name}/Equipment/[{equipIndex}]/slot {k}")!, free.ToString());
            S.Replace(next, $"{Slot.Name} {WhoName}: added {SaoItems.NameOf(itemId)} to the bag and equipped it as {GearNames[k]}.");
        }
        catch (Exception ex) when (ex is ArgumentException or SaoParseException or InvalidDataException)
        {
            S.Rebuild();
            S.Notice($"Nothing was changed.\n\n{ex.Message}");
        }
    }
}
